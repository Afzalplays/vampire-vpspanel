# Copy to .env.production and replace all secrets before deploying.
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOSTNAME=127.0.0.1

# SMTP and hypervisor credentials must be kept out of Git.
# SMTP settings are configured in the admin panel.
# Proxmox URL/token ID/node are stored by the admin hypervisor API; keep the token secret here.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
PROXMOX_TOKEN_SECRET=replace-with-your-proxmox-api-token-secret

# KVM/QEMU libvirt agent. Keep the bearer token secret and use a private/VPN URL.
LIBVIRT_AGENT_URL=http://10.0.0.2:8765
LIBVIRT_AGENT_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Set true only when HTTP is protected by a trusted private/VPN network.
LIBVIRT_ALLOW_PRIVATE_HTTP=true
